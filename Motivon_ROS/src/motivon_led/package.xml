<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motivon_led</name>
  <version>0.1.0</version>
  <description>Mission-state LED strip feedback for the Motivon robot.</description>
  <maintainer email="student@example.com">Motivon Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>motivon_interfaces</depend>
  <depend>rclpy</depend>
  <exec_depend>python3-spidev</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
